% ---------- fonts --------------------------------------------
% Body text: iA Writer Quattro -- IBM Plex Mono redrawn with
%   proportional widths, so it reads like normal text but keeps
%   the terminal look (credit: iA Inc., based on IBM Plex; OFL 1.1).
% Labels (titles, box bars, footer, numbers): IBM Plex Mono.
% Math: standard LaTeX (Computer Modern), untouched.
\usefonttheme{professionalfonts}
\usefonttheme[onlymath]{serif}
\ifPDFTeX
  \PackageWarning{beamerthememarginal}{Compile with XeLaTeX or LuaLaTeX for the theme fonts}
  \RequirePackage[T1]{fontenc}
  \RequirePackage[scale=0.95]{plex-mono}
  \RequirePackage{plex-sans}
  \renewcommand*\familydefault{\sfdefault}
\else
  \PassOptionsToPackage{no-math}{fontspec}
  \RequirePackage{fontspec}
  \ifmg@systemfont
    \setmainfont{iA Writer Quattro S}
    \setsansfont{iA Writer Quattro S}
    \setmonofont{IBM Plex Mono}[LetterSpace=1.0, WordSpace=1.05,
      FontFace={sb}{n}{IBM Plex Mono SemiBold}, FontFace={mb}{n}{IBM Plex Mono Medium}]
  \else
    \defaultfontfeatures{Path=./fonts/, Extension=.ttf,
      UprightFont=*-Regular, ItalicFont=*-Italic,
      BoldFont=*-Bold, BoldItalicFont=*-BoldItalic}
    \setmainfont{iAWriterQuattroS}
    \setsansfont{iAWriterQuattroS}
    \defaultfontfeatures{Path=./fonts/, Extension=.otf,
      LetterSpace=1.0, WordSpace=1.05,
      UprightFont=*-Regular, ItalicFont=*-Italic,
      BoldFont=*-Bold, BoldItalicFont=*-BoldItalic,
      FontFace={sb}{n}{*-SemiBold}, FontFace={mb}{n}{*-Medium},
      FontFace={l}{n}{*-Light}}
    \setmonofont{IBMPlexMono}
  \fi
  \defaultfontfeatures{}
\fi
