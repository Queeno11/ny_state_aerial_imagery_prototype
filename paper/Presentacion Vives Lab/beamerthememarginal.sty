% ============================================================
%  beamerthememarginal.sty  --  "Marginal" Beamer theme
%  Monospaced, minimal, a little colour. For economists.
%
%  Fonts: iA Writer Quattro by iA Inc. (OFL 1.1, based on IBM
%  Plex) and IBM Plex Mono by IBM (OFL 1.1).
%  Layout ideas (window boxes with hard shadows, block progress
%  bar, [nn/NN] page counter) adapted from the "Terminal" theme
%  by Sheikh Azizul Hakim (CC BY 4.0). Palette adapted from the
%  light/dark themes of the pi coding agent (MIT).
%
%  Compile with XeLaTeX or LuaLaTeX (twice, for the frame count).
%  Options:  dark            pi-style dark palette
%            nosectionpages  no section divider slides
%            noprogressbar   footer without the block bar
%            nouppercase     frame titles in sentence case
%            imageframes     frame + shadow on every \includegraphics
%                            (default: plain images, as in LaTeX)
%            systemfont      use IBM Plex Mono installed on the
%                            system instead of ./fonts/
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthememarginal}[2026/10/13 Marginal beamer theme]

\RequirePackage{iftex}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins}
\RequirePackage{booktabs}
\RequirePackage{colortbl}

% ---------- options -----------------------------------------
\newif\ifmg@dark          \mg@darkfalse
\newif\ifmg@sectionpages  \mg@sectionpagestrue
\newif\ifmg@progressbar   \mg@progressbartrue
\newif\ifmg@uppercase     \mg@uppercasetrue
\newif\ifmg@systemfont    \mg@systemfontfalse
\newif\ifmg@imageframes   \mg@imageframesfalse
\DeclareOptionBeamer{dark}{\mg@darktrue}
\DeclareOptionBeamer{nosectionpages}{\mg@sectionpagesfalse}
\DeclareOptionBeamer{noprogressbar}{\mg@progressbarfalse}
\DeclareOptionBeamer{nouppercase}{\mg@uppercasefalse}
\DeclareOptionBeamer{systemfont}{\mg@systemfonttrue}
\DeclareOptionBeamer{imageframes}{\mg@imageframestrue}
\DeclareOptionBeamer{noimageframes}{\mg@imageframesfalse}
\ProcessOptionsBeamer

