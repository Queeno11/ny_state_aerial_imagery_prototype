{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [".claude/hooks/guard-edits.sh"],
            "statusMessage": "Checking edit is within src/, paper/, or CLAUDE.md..."
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "/home/abbatenicolas/data/cache",
        "/home/abbatenicolas/outputs",
        ".../src",
        ".../paper",
        ".../CLAUDE.md",
        ".../.claude/plans"
      ],
      "denyWrite": [
        ".../.claude/settings.json",
        ".../.claude/settings.local.json",
        ".../.claude/hooks",
        "/home/abbatenicolas/.claude/settings.json",
        "/home/abbatenicolas/.claude/hooks",
        ".../data", ".../logs", ".../pretrained",
        ".../results", ".../docs", ".../models",
        ".../wandb", ".../.git"
      ]
    },
    "network": {
      "allowedDomains": [
        "www2.census.gov",
        "planetarycomputer.microsoft.com",
        "*.blob.core.windows.net",
        "api.census.gov",
        "huggingface.co",
        "*.hf.co",
        "cdn-lfs.huggingface.co",
        "*.wandb.ai",
        "pypi.org",
        "files.pythonhosted.org",
        "conda.anaconda.org",
        "repo.anaconda.com",
        "download.pytorch.org",
        "github.com",
        "*.githubusercontent.com"
      ]
    },
    "credentials": {
      "files": [
        { "path": "/mnt/c/Working Papers/NY State Aerial Imagery Prototype/ny_state_aerial_imagery_prototype/.env.secrets", "mode": "deny" },
        { "path": "/home/abbatenicolas/.claude/.credentials.json", "mode": "deny" }
      ],
      "envVars": [
        { "name": "WANDB_API_KEY", "mode": "deny" },
        { "name": "HF_TOKEN", "mode": "deny" },
        { "name": "CENSUS_API_KEY", "mode": "deny" }
      ]
    }
  }
}